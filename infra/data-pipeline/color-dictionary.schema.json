{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitzza.local/schemas/data-pipeline/color-dictionary.schema.json",
  "title": "Fitzza approved color dictionary",
  "description": "Human-approved color_raw mappings carried across runs so that only unseen color names go to Jev and human review. Design only: no code reads this yet (FITZZA-306).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dictionary_version", "previous_version", "created_at", "colors"],
  "properties": {
    "schema_version": { "const": 1 },
    "dictionary_version": { "type": "string", "pattern": "^v[0-9]{4}$" },
    "previous_version": { "type": ["string", "null"], "pattern": "^v[0-9]{4}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "colors": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
      "additionalProperties": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color", "basis", "approved_run_id", "approved_bundle_sha256", "approved_at"],
      "properties": {
        "color": {
          "enum": ["black", "white", "ivory", "beige", "gray", "charcoal", "navy", "blue", "green",
                   "khaki", "brown", "red", "pink", "purple", "yellow", "orange", "multi", "etc"]
        },
        "basis": {
          "description": "human_decision: listed in reviewed_colors.json of the approved bundle. approved_jev: a confident Jev result accepted as part of an approved bundle without an individual decision.",
          "enum": ["human_decision", "approved_jev"]
        },
        "approved_run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
        "approved_bundle_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "approved_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
