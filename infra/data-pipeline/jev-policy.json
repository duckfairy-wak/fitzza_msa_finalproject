{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadCuratedProductsAndPriorResponses",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::fitzza-prod-foundation-databucket-wwng6wfc0hqy/pipeline/runs/collection-20261025-01/curated/manifest.json",
        "arn:aws:s3:::fitzza-prod-foundation-databucket-wwng6wfc0hqy/pipeline/runs/collection-20261025-01/curated/data/*",
        "arn:aws:s3:::fitzza-prod-foundation-databucket-wwng6wfc0hqy/pipeline/runs/collection-20261025-01/jev/color_map_jev_results.jsonl"
      ]
    },
    {
      "Sid": "CheckPriorResponsesExist",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::fitzza-prod-foundation-databucket-wwng6wfc0hqy",
      "Condition": {
        "StringEquals": {
          "s3:prefix": "pipeline/runs/collection-20261025-01/jev/color_map_jev_results.jsonl"
        }
      }
    },
    {
      "Sid": "WriteJevReviewOnly",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::fitzza-prod-foundation-databucket-wwng6wfc0hqy/pipeline/runs/collection-20261025-01/jev/*"
    },
    {
      "Sid": "ReadJevKeyOnly",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:ap-northeast-2:414901227428:parameter/fitzza/prod/data-pipeline/typesafe-api-key"
    },
    {
      "Sid": "DecryptViaSsmOnly",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:ap-northeast-2:414901227428:key/a4a303e7-fbc7-45ec-8798-2480c7176e7b",
      "Condition": {"StringEquals": {"kms:ViaService": "ssm.ap-northeast-2.amazonaws.com"}}
    }
  ]
}
