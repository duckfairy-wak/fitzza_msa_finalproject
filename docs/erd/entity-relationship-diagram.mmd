erDiagram
%% ===== user (구현) =====
    users ||..o| user_body : ""

    users {
        bigint user_id PK
        varchar email UK
        varchar password
        varchar nickname UK
        varchar status
        varchar role
        datetime created_at
        datetime updated_at
    }

    user_body {
        bigint user_id PK
        float height
        float weight
        char gender
        varchar preferred_styles
        varchar preferred_fit
        int shoe_size
        datetime updated_at
    }

%% ===== product (구현) =====
    brand ||--o{ product : ""
    product ||--o{ product_option : ""
    product ||--o{ product_image : ""
    product ||--o| product_size_guide : ""
    product_option ||--o| option_measurement : ""
    product ||--o{ worldcup_history : ""
    category |o..o{ category : ""
    users ||..o{ wishlist : ""
    users ||..o{ worldcup_history : ""

    brand {
        bigint brand_id PK
        varchar brand_name UK
        varchar brand_name_en
        varchar brand_code UK
    }

    category {
        varchar category_code PK
        varchar category_name
        varchar parent_code
        int depth
    }

    product {
        bigint product_id PK "무신사 상품번호 (자동 번호 아님)"
        bigint brand_id FK
        varchar source
        varchar source_url
        varchar product_name
        varchar product_name_en
        varchar style_no
        varchar gender
        varchar category_1
        varchar category_2
        varchar subcategory
        int price
        int normal_price
        int discount_rate
        varchar material
        varchar season
        varchar fit_type
        json features
        json color_image_mappings
        text description
        varchar image_url
        varchar status
        datetime created_at
        datetime updated_at
    }

    product_option {
        bigint option_id PK
        bigint product_id FK
        bigint source_option_id UK
        varchar managed_code
        varchar color
        varchar size
        int additional_price
        varchar image_url
    }

    option_measurement {
        bigint option_id PK, FK
        varchar size_label
        int sequence
        json measurement_spec
    }

    product_image {
        bigint image_id PK
        bigint product_id FK, UK
        varchar image_url
        int sequence UK
    }

    product_size_guide {
        bigint product_id PK, FK
        varchar type_name
        varchar unit
        varchar description
        varchar guide_image_url
    }

    wishlist {
        bigint wishlist_id PK
        bigint user_id UK
        varchar item_id UK
        varchar item_type UK
        datetime created_at
    }

    worldcup_history {
        bigint worldcup_history_id PK
        bigint user_id
        bigint winner_product_id FK
        datetime completed_at
    }

%% ===== order / cart (구현) =====
    users ||..o{ orders : ""
    users ||..o{ cart : ""
    orders ||--|{ order_item : ""
    product_option ||..o{ order_item : ""
    product_option ||..o{ cart : ""

    orders {
        bigint order_id PK
        varchar order_num UK
        bigint user_id
        bigint total_price
        varchar order_status
        varchar recipient_name
        varchar recipient_phone
        varchar shipping_address
        datetime created_at
        datetime updated_at
    }

    order_item {
        bigint order_item_id PK
        bigint order_id FK
        bigint option_id
        int order_qty
        int unit_price
    }

    cart {
        bigint cart_id PK
        bigint user_id UK
        bigint option_id UK
        int quantity
        datetime created_at
        datetime updated_at
    }

