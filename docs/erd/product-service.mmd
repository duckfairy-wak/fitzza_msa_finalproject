erDiagram
    %% Central service: product-service
    %% Source: ../entity-relationship-diagram.mmd
    %% Original columns, cardinalities and line styles preserved.
    %% || = exactly one; o| = zero or one; o{ = zero or more; |{ = one or more.
    %% Edge labels name the referencing column in the child table.
    %% Cross-service edges are logical references, not cross-schema FK or direct access.
    %% Owned tables: brand, category, product, product_option, option_measurement, product_image, product_size_guide, wishlist, worldcup_history
    %% External table: cart (order-service)
    %% External table: fitting_products (vton-service)
    %% External table: order_item (order-service)
    %% External table: reviews (review-service)
    %% External table: size_feedback_logs (recommendation-service)
    %% External table: size_surveys (review-service)
    %% External table: users (user-service)

    %% Internal and directly connected external relationships
    brand ||--o{ product : "brand_id"
    product ||--o{ product_option : "product_id"
    product ||--o{ product_image : "product_id"
    product ||--o| product_size_guide : "product_id"
    product_option ||--o| option_measurement : "option_id"
    product ||--o{ worldcup_history : "winner_product_id"
    category |o..o{ category : "parent_code"
    users ||..o{ wishlist : "user_id"
    users ||..o{ worldcup_history : "user_id"
    product_option ||..o{ order_item : "option_id"
    product_option ||..o{ cart : "option_id"
    product ||..o{ reviews : "product_id"
    product |o..o{ size_surveys : "product_id"
    product_option ||..o{ size_surveys : "option_id"
    product ||..o{ size_feedback_logs : "product_id"
    product_option ||..o{ size_feedback_logs : "option_id"
    product ||..o{ fitting_products : "product_id"

    brand {
        bigint brand_id PK
        varchar brand_name UK
        varchar brand_name_en
        varchar brand_code UK
    }

    category {
        varchar category_code PK
        varchar category_name
        varchar parent_code
        int depth
    }

    product {
        bigint product_id PK "무신사 상품번호 (자동 번호 아님)"
        bigint brand_id FK
        varchar source
        varchar source_url
        varchar product_name
        varchar product_name_en
        varchar style_no
        varchar gender
        varchar category_1
        varchar category_2
        varchar subcategory
        int price
        int normal_price
        int discount_rate
        varchar material
        varchar season
        varchar fit_type
        json features
        json color_image_mappings
        text description
        varchar image_url
        varchar status
        datetime created_at
        datetime updated_at
    }

    product_option {
        bigint option_id PK
        bigint product_id FK
        bigint source_option_id UK
        varchar managed_code
        varchar color
        varchar size
        int additional_price
        varchar image_url
    }

    option_measurement {
        bigint option_id PK, FK
        varchar size_label
        int sequence
        json measurement_spec
    }

    product_image {
        bigint image_id PK
        bigint product_id FK, UK
        varchar image_url
        int sequence UK
    }

    product_size_guide {
        bigint product_id PK, FK
        varchar type_name
        varchar unit
        varchar description
        varchar guide_image_url
    }

    wishlist {
        bigint wishlist_id PK
        bigint user_id UK
        varchar item_id UK
        varchar item_type UK
        datetime created_at
    }

    worldcup_history {
        bigint worldcup_history_id PK
        bigint user_id
        bigint winner_product_id FK
        datetime completed_at
    }

    cart {
        bigint cart_id PK
        bigint user_id UK
        bigint option_id UK
        int quantity
        datetime created_at
        datetime updated_at
    }

    fitting_products {
        bigint id PK
        bigint fitting_id FK
        bigint product_id
        text product_name
        int price
        text image_url
        varchar category_name
    }

    order_item {
        bigint order_item_id PK
        bigint order_id FK
        bigint option_id
        int order_qty
        int unit_price
    }

    reviews {
        bigint review_id PK
        varchar source UK
        bigint source_review_id UK
        bigint user_id
        bigint product_id
        bigint order_item_id UK
        int rating
        text content
        varchar image_url
        bigint version
        datetime created_at
        datetime updated_at
    }

    size_feedback_logs {
        bigint feedback_id PK
        bigint user_id
        bigint product_id
        bigint option_id
        varchar size_feedback
        datetime created_at
    }

    size_surveys {
        bigint survey_id PK
        bigint user_id UK
        bigint product_id
        bigint option_id
        bigint order_item_id UK
        varchar size_feedback
        datetime feedback_sent_at
        datetime feedback_claimed_at
        datetime created_at
    }

    users {
        bigint user_id PK
        varchar email UK
        varchar password
        varchar nickname UK
        varchar status
        varchar role
        datetime created_at
        datetime updated_at
    }
