# Docker Compose용 예시입니다. .env로 복사한 뒤 필수 비밀값을 입력하세요.
# IDE에서 직접 실행할 때는 환경변수를 별도로 설정해야 합니다.

# 서비스 주소: Compose 네트워크 내부 주소입니다.
# 비워 두면 docker-compose.yml의 기본값을 사용합니다.
CONFIG_SERVICE_URL=http://config-service:8888
DISCOVERY_SERVICE_URL=http://discovery-service:8761/eureka/
USER_SERVICE_URL=http://user-service:8081
PRODUCT_SERVICE_URL=http://product-service:8082
NOTIFICATION_SERVICE_URL=http://notification-service:8086
RECOMMENDATION_SERVICE_URL=http://recommendation-service:8000
VTON_SERVICE_URL=http://vton-service:8000

# PostgreSQL: 로컬 개발용 공용 계정
# Compose의 POSTGRES_HOST/POSTGRES_PORT는 postgres:5432로 고정되어 있습니다.
POSTGRES_DB=fitzza
POSTGRES_USER=fitzza
POSTGRES_PASSWORD=fitzza_local

# 서비스 전용 DB 계정(선택): 주석 상태에서는 위 공용 계정을 사용합니다.
# 생성 방법: infra/postgres/service-accounts.sql 및 README의 서비스별 DB 계정 참고
# USER_SERVICE_DB_USER=user_service_app
# USER_SERVICE_DB_PASSWORD=

# PRODUCT_SERVICE_DB_USER=product_service_app
# PRODUCT_SERVICE_DB_PASSWORD=

# ORDER_SERVICE_DB_USER=order_service_app
# ORDER_SERVICE_DB_PASSWORD=

# COMMUNITY_SERVICE_DB_USER=community_service_app
# COMMUNITY_SERVICE_DB_PASSWORD=

# REVIEW_SERVICE_DB_USER=review_service_app
# REVIEW_SERVICE_DB_PASSWORD=

# NOTIFICATION_SERVICE_DB_USER=notification_service_app
# NOTIFICATION_SERVICE_DB_PASSWORD=

# Redis: Compose의 REDIS_HOST/REDIS_PORT는 redis:6379로 고정되어 있습니다.
REDIS_PASSWORD=fitzza_local

# AWS / LocalStack: 아래 인증정보는 로컬 개발용입니다.
# Compose의 AWS_ENDPOINT_URL은 http://localstack:4566으로 고정되어 있습니다.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-northeast-2
AWS_S3_BUCKET_NAME=fitzza-prod-assets-vton
AWS_SQS_QUEUE_URL=http://localstack:4566/000000000000/vton-jobs
AWS_SQS_DLQ_URL=http://localstack:4566/000000000000/vton-jobs-dlq

VTON_STORAGE_BACKEND=s3
VTON_QUEUE_BACKEND=sqs

# JWT: 필수. 32바이트 이상의 무작위 비밀값을 직접 입력하세요.
JWT_SECRET=

# Access Token은 1~900초, Refresh Token 기본값은 30일입니다.
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=2592000

# Refresh Token 쿠키: 로컬 HTTP는 false, 운영 HTTPS는 true
REFRESH_COOKIE_SECURE=false

# 서비스 인증 토큰: X-Service-Token 헤더에 사용합니다.
# 설정하는 토큰은 각각 32바이트 이상이고 서로 다른 무작위 값이어야 합니다.

# 필수: community-service가 user/notification/product-service를 호출할 때 사용
COMMUNITY_SERVICE_TOKEN=

# 필수: order-service가 product-service를 호출할 때 사용
ORDER_SERVICE_TOKEN=

# 필수: review-service가 order-service를 호출하고 추천 서비스에 피드백을 보낼 때 사용
REVIEW_SERVICE_TOKEN=

# 선택: recommendation-service의 사용자 조회, 상품 조회, 알림 전송에 사용
RECOMMENDATION_SERVICE_TOKEN=

# 선택: vton-service의 알림 전송에 사용
VTON_SERVICE_TOKEN=

# 선택: product-service의 서비스 간 호출 인증에 사용
PRODUCT_SERVICE_TOKEN=

# product-service 상품 이미지 Presigned GET (비공개 데이터 버킷).
# 로컬 기본은 꺼짐. EKS에서는 true + 버킷명 + Pod Identity(S3 GetObject) 필요.
# PRODUCT_IMAGE_PRESIGN_ENABLED=false
# PRODUCT_IMAGE_S3_BUCKET=fitzza-prod-foundation-databucket-wwng6wfc0hqy
# PRODUCT_IMAGE_PRESIGN_TTL=1h

# AI / 벡터 검색
OPENAI_API_KEY=
QDRANT_URL=http://qdrant:6333

# TypeSafe: 비워 두면 댓글의 투표 지지 선택지 판정을 건너뜁니다.
TYPESAFE_API_KEY=
TYPESAFE_API_URL=https://api.typesafe.ai
JEV_SUPPORT_THRESHOLD=0.6

# Firebase: 서비스 계정 JSON의 base64 값. 비워 두면 푸시 없이 알림만 저장합니다.
FIREBASE_CREDENTIALS=

# Gateway: 허용할 프런트엔드 Origin을 쉼표로 구분합니다.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Micrometer → Jaeger OTLP. yml 기본 샘플링은 0.0(꺼짐). Compose는 아래를 1.0 / jaeger:4318 로 켠다.
# IDE에서 켤 때: docker compose up -d jaeger 후 샘플링 1.0과 localhost:4318 을 지정한다.
# MANAGEMENT_OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
# MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
