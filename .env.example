POSTGRES_DB=fitzza
POSTGRES_USER=fitzza
POSTGRES_PASSWORD=fitzza_local
REDIS_PASSWORD=fitzza_local
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-northeast-2
# Required: set a randomly generated secret of at least 32 bytes before starting Compose.
JWT_SECRET=
# Required: set a separate random secret for trusted service-to-service calls (at least 32 bytes).
INTERNAL_CALL_TOKEN=
# Access Token: 15 minutes; Refresh Token: 30 days.
# Access Token 유효 기간은 1~900초만 허용합니다.
JWT_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=2592000
