POSTGRES_DB=fitzza
POSTGRES_USER=fitzza
POSTGRES_PASSWORD=fitzza_local
REDIS_PASSWORD=fitzza_local
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-northeast-2
# Required: set a randomly generated secret of at least 32 bytes before starting Compose.
JWT_SECRET=
# Required: set a separate random secret for trusted service-to-service calls (at least 32 bytes).
INTERNAL_CALL_TOKEN=
# Required: absolute paths outside the repository, readable by the container's fitzza user.
# Certificate SAN must include DNS:user-service; include the full certificate chain.
USER_SERVICE_TLS_CERTIFICATE_FILE=
USER_SERVICE_TLS_PRIVATE_KEY_FILE=
# JKS truststore containing the issuing CA (certificate entries only, no private keys).
USER_SERVICE_TLS_TRUSTSTORE_FILE=
